# Copie este arquivo para .env e preencha os valores antes de subir o stack.
# NUNCA commite o .env real no Git (adicione ao .gitignore do repo do homelab).

# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=

# Gere com: openssl rand -hex 32
# CRÍTICO: depois de gerada, guarde essa chave também no seu KeePassXC/Obsidian.
# Se você recriar o container sem ela, perde acesso a TODAS as credenciais
# salvas no n8n (API keys, tokens OAuth, etc).
N8N_ENCRYPTION_KEY=

# IP ou hostname do melchior na rede (ou hostname .home via Pi-hole)
N8N_HOST=192.168.18.195

# URL completa que o n8n usa para montar webhooks.
# Se for acessar só via Tailscale, use o IP/hostname do Tailscale aqui.
# Se for acessar via .home (Pi-hole), use algo tipo http://n8n.home:5678/
WEBHOOK_URL=http://192.168.18.195:5678/
